# ==================== 必需的环境变量 ====================
# 请取消以下必需的环境变量注释，并填入正确的值后才能运行

# OpenAI API 密钥（必需）
#OPENAI_API_KEY=your-openai-api-key-here

# GitHub Personal Access Token（用于推送代码到 data 分支，需要 repo 权限，必需）
#GIT_TOKEN=ghp_your-github-token-here

# GitHub 仓库格式（例如：username/repo-name，必需）
#GIT_REPO=your-username/your-repo-name

# Git 提交者邮箱（必需）
#GIT_EMAIL=your-email@example.com

# Git 提交者名称（注意：如果名称中包含空格，需要用引号括起来，例如：'Your Name' 或 "Your Name"，必需）
#GIT_NAME="Your Name"

# ==================== 可选的环境变量 ====================

# 定时任务时间表，默认为每天 UTC 时间 01:40 执行（即北京时间 09:33）
CRON_SCHEDULE="30 1 * * *"

# OpenAI API 基础 URL（用于使用兼容 OpenAI 的其他服务）
OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的 LLM 模型名称
MODEL_NAME=deepseek-chat

# 输出语言
LANGUAGE=Chinese

# arXiv 分类（逗号分隔，例如：cs.AI, cs.CL, cs.CV）
CATEGORIES="cs.AI, cs.CL, cs.CV"

# 并行处理工作线程数
MAX_WORKERS=1

# 企业微信 Webhook URL（用于通知，留空则不发送）
WECHAT_WEBHOOK_URL=

# 访问密码（留空则不启用密码保护）
PASSWORD=

# 默认过滤关键词（逗号分隔）
DEFAULT_KEYWORDS=

# 默认过滤作者（逗号分隔）
DEFAULT_AUTHORS=

# 黑名单关键词（用于AI增强处理时跳过特定论文，逗号、分号或空格分隔）
BLACKLIST_KEYWORDS=
